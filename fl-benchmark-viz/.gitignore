# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Regenerated from ../results/ via scripts/copy-results + scripts/generate-manifest.
# (Avoid double-storing the CSVs that already live at the repo root.)
public/results/

# The repo-root .gitignore has `lib/` (for the Python venv's lib dir);
# unignore our TypeScript src/lib so it gets tracked.
!src/lib/
!src/lib/*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
